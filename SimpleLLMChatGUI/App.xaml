<Application x:Class="SimpleLLMChatGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <!-- ===================== -->
        <!-- SHARED DATA TEMPLATES -->
        <!-- ===================== -->

        <!-- Multi-select ListBox ItemTemplate with CheckBoxes -->
        <DataTemplate x:Key="MultiSelectListBoxItemTemplate">
            <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}"
                     Foreground="{x:Static SystemColors.ControlTextBrush}">
                <TextBlock Text="{Binding}"/>
            </CheckBox>
        </DataTemplate>

        <!-- ===================== -->
        <!-- DYNAMIC COLOR BRUSHES -->
        <!-- ===================== -->

        <!-- Dynamic brush for button text color -->
        <SolidColorBrush x:Key="ButtonTextColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}"/>

        <!-- Dynamic brush for chat background color -->
        <SolidColorBrush x:Key="ChatBackgroundColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>

        <!-- Dynamic brush for label text color -->
        <SolidColorBrush x:Key="LabelTextColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}"/>

        <!-- Dynamic brush for chat text color -->
        <SolidColorBrush x:Key="ChatTextColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>

        <!-- Dynamic brush for code block background color -->
        <SolidColorBrush x:Key="CodeBlockBackgroundColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>

        <!-- Dynamic brush for window background color -->
        <SolidColorBrush x:Key="WindowBackgroundColorBrush"
                          Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>

        <!-- Dynamic brush for button background color -->
        <SolidColorBrush x:Key="ButtonBackgroundBrush"
                          Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>

        <!-- Dynamic brush for button border color -->
        <SolidColorBrush x:Key="ButtonBorderBrush"
                           Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}"/>

        <!-- Dynamic brush for the user message bubble background -->
        <SolidColorBrush x:Key="UserBubbleBackgroundBrush"
                           Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>

        <!-- Dynamic brush for code block header (language bar) background -->
        <SolidColorBrush x:Key="CodeBlockHeaderBrush"
                           Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>

        <!-- Dynamic brush for hyperlink text -->
        <SolidColorBrush x:Key="LinkBrush"
                           Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}"/>

        <!-- Dynamic brush for role labels and timestamps -->
        <SolidColorBrush x:Key="RoleLabelBrush"
                           Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}"/>

        <!-- ===================== -->
        <!-- FLAT BUTTON TEMPLATES -->
        <!-- ===================== -->

        <!-- Flat template for Buttons -->
        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Rectangle x:Name="Overlay"
                               Fill="#11000000"
                               Visibility="Collapsed"/>
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Overlay" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Overlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Overlay" Property="Fill" Value="#22000000"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Flat template for ToggleButtons (adds checked state) -->
        <ControlTemplate x:Key="FlatToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Rectangle x:Name="Overlay"
                               Fill="#11000000"
                               Visibility="Collapsed"/>
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Overlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Overlay" Property="Fill" Value="#1A000000"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Overlay" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Overlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Overlay" Property="Fill" Value="#22000000"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ===================== -->
        <!-- GLOBAL CONTROL STYLES -->
        <!-- ===================== -->

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2,6,2"/>
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
        </Style>

        <!-- ToggleButtons -->
        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template" Value="{StaticResource FlatToggleButtonTemplate}"/>
        </Style>

        <!-- RichTextBoxes -->
        <Style TargetType="RichTextBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ChatBackgroundColorBrush}"/>
        </Style>

        <!-- TextBoxes -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ChatBackgroundColorBrush}"/>
        </Style>

        <!-- PasswordBoxes -->
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ChatBackgroundColorBrush}"/>
        </Style>

        <!-- ListBoxes -->
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
        </Style>

        <!-- CheckBoxes -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource LabelTextColorBrush}"/>
        </Style>

        <!-- Labels -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource LabelTextColorBrush}"/>
        </Style>

    </Application.Resources>
</Application>
