<Window x:Class="SimpleLLMChatGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimpleLLMChatGUI"
        Title="Simple LLM Chat" Height="350" Width="450" Loaded="Window_Loaded"
        MinWidth="415" MinHeight="200"
        Background="{DynamicResource WindowBackgroundColorBrush}">
    <Window.Resources>
        <!-- +/- toggle for collapsible thinking / tool-call blocks -->
        <Style x:Key="ThinkingExpandToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Width="9" Height="9"
                                    BorderBrush="{TemplateBinding Foreground}"
                                    BorderThickness="1"
                                    Background="Transparent"
                                    Margin="0,1,5,0"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Rectangle x:Name="Horizontal"
                                               Width="5" Height="1"
                                               Fill="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Rectangle x:Name="Vertical"
                                               Width="1" Height="5"
                                               Fill="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Vertical" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinkingExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="False">
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          Style="{StaticResource ThinkingExpandToggleStyle}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{TemplateBinding Header}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Left"
                                          Padding="0"/>
                            <ContentPresenter x:Name="ExpandSite"
                                              DockPanel.Dock="Top"
                                              ContentSource="Content"
                                              Visibility="Collapsed"
                                              Margin="0"
                                              VerticalAlignment="Top"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Top row: buttons -->
            <RowDefinition Height="*" />
            <!-- Chat output -->
            <RowDefinition Height="Auto" />
            <!-- Chat input + button -->
            <RowDefinition Height="Auto" />
            <!-- Token status bar -->
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <Button Name="clearButton"
                        AutomationProperties.AutomationId="clearButton"
                        Content="Clear"
                        MinWidth="60"
                        MinHeight="25"
                        Margin="0,0,5,0"
                        Click="clearButton_Click" />

                <Button Name="saveButton"
                        AutomationProperties.AutomationId="saveButton"
                        Content="Save"
                        MinWidth="55"
                        MinHeight="25"
                        Margin="0,0,5,0"
                        Click="saveButton_Click" />

                <Button Name="loadButton"
                        AutomationProperties.AutomationId="loadButton"
                        Content="Load"
                        MinWidth="55"
                        MinHeight="25"
                        Click="loadButton_Click" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Name="compactButton"
                        AutomationProperties.AutomationId="compactButton"
                        Content="Compact"
                        MinWidth="65"
                        MinHeight="25"
                        Margin="0,0,5,0"
                        ToolTip="Force full context compaction (micro + summarize)"
                        Click="compactButton_Click" />

                <Button Name="themeButton"
                        AutomationProperties.AutomationId="themeButton"
                        Content="&#x263E;"
                        MinWidth="40"
                        MinHeight="25"
                        Margin="0,0,5,0"
                        ToolTip="Switch to dark theme"
                        Click="themeButton_Click" />

                <Button Name="optionsButton"
                        Content="Options"
                        MinWidth="80"
                        MinHeight="25"
                        VerticalAlignment="Center"
                        Click="optionsButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Chat history: one turn per item; clicking an item never selects it,
             so buttons inside a turn do not trigger the auto scroll-into-view -->
        <local:ChatListBox
                   x:Name="chatList"
                   AutomationProperties.AutomationId="chatList"
                  Grid.Row="1"
                  Margin="0,0,0,5"
                 Padding="4"
                 BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch"
                  Background="{DynamicResource ChatBackgroundColorBrush}"
                  Foreground="{DynamicResource ChatTextColorBrush}">
            <local:ChatListBox.ItemContainerStyle>
                <Style TargetType="{x:Type local:ChatListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin"
                            Value="{Binding ChatTurnItemMargin, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type local:ChatListBoxItem}">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </local:ChatListBox.ItemContainerStyle>
            <local:ChatListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ChatTurn}">
                    <local:ChatTurnView Turn="{Binding}"/>
                </DataTemplate>
            </local:ChatListBox.ItemTemplate>
        </local:ChatListBox>

        <!-- Bottom bar: approval mode + attach + input + stop tool + send -->
        <Grid Grid.Row="2" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Name="approvalModeButton"
                    AutomationProperties.AutomationId="approvalModeButton"
                    Grid.Column="0"
                    Content="config"
                    MinWidth="72"
                    MinHeight="40"
                    Margin="0,0,5,0"
                    VerticalAlignment="Stretch"
                    ToolTip="Tool approval mode. ask = confirm every tool call, auto = never confirm, config = confirm only the tools listed in toolsRequiringApproval. Click to switch."
                    Click="approvalModeButton_Click" />

            <ToggleButton Name="attachButton"
                          Grid.Column="1"
                          MinWidth="45"
                          MinHeight="40"
                          Margin="0,0,5,0"
                          VerticalAlignment="Stretch"
                          ToolTip="Attach Image (if supported by model)"
                          Checked="attachButton_Checked"
                          Unchecked="attachButton_Unchecked">
                <Image Source="pack://application:,,,/Resources/photoframe.png"
                       Width="20" Height="20" Stretch="Uniform"/>
            </ToggleButton>

            <TextBox Name="chatInput"
                     AutomationProperties.AutomationId="chatInput"
                     Grid.Column="2"
                     MinHeight="40"
                     MaxHeight="100"
                     VerticalAlignment="Stretch"
                     Margin="0,0,5,0"
                     HorizontalAlignment="Stretch"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="chatInput_PreviewKeyDown" />

            <Button Name="stopToolButton"
                    AutomationProperties.AutomationId="stopToolButton"
                    Grid.Column="3"
                    Content="Stop tool"
                    MinWidth="75"
                    MinHeight="40"
                    Margin="0,0,5,0"
                    VerticalAlignment="Stretch"
                    IsEnabled="False"
                    ToolTip="Cancel the currently running tool call"
                    Click="stopToolButton_Click" />

            <Button Name="sendButton"
                    AutomationProperties.AutomationId="sendButton"
                    Grid.Column="4"
                    Content="Send"
                    MinWidth="60"
                    MinHeight="40"
                    VerticalAlignment="Stretch"
                    Click="sendButton_Click" />
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="3" Margin="0" Padding="0"
                   Background="Transparent"
                   Foreground="{DynamicResource LabelTextColorBrush}"
                   FontFamily="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontFamily}"
                   FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0" Padding="0" Margin="0" HorizontalAlignment="Left">
                <TextBlock Cursor="Hand"
                           MouseLeftButtonUp="reasoningEffortLabel_MouseLeftButtonUp">
                    <Run Text="Reasoning: "/>
                    <Run x:Name="reasoningEffortLabel"
                         Text="Default"
                         TextDecorations="Underline"/>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" Padding="0" Margin="0" HorizontalAlignment="Right">
                <TextBlock Name="tokenStatusText"
                           AutomationProperties.AutomationId="tokenStatusText"
                           Text="Tokens: ~0" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
