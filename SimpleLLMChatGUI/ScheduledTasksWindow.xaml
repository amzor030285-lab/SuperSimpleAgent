<Window x:Class="SimpleLLMChatGUI.ScheduledTasksWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SimpleLLMChatGUI"
             Title="Scheduled tasks" Height="560" Width="720"
            MinHeight="420" MinWidth="560"
            WindowStartupLocation="CenterOwner"
            ResizeMode="CanResize"
            Background="{DynamicResource WindowBackgroundColorBrush}"
            Foreground="{DynamicResource LabelTextColorBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- New task form -->
        <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8" Header="New task">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Margin="0,0,6,4" VerticalAlignment="Center"/>
                <TextBox x:Name="newTaskName" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,6,4"
                         AutomationProperties.AutomationId="newTaskName" MinHeight="24"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Schedule:" Margin="0,0,6,4" VerticalAlignment="Center"/>
                <local:ScheduleEditor x:Name="scheduleEditor" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,6,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Prompt:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBox x:Name="newTaskPrompt" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,6,0"
                         AutomationProperties.AutomationId="newTaskPrompt" MinHeight="24"/>

                <Button x:Name="addTaskButton" Grid.Row="1" Grid.Column="3" Grid.RowSpan="2" Content="Add"
                        Margin="6,4,0,4" MinWidth="70" MinHeight="24" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="addTaskButton"
                        Click="addTaskButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- Task list -->
        <GroupBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" Header="Tasks">
            <ListBox x:Name="scheduledTasksList"
                     AutomationProperties.AutomationId="scheduledTasksList"
                     SelectionChanged="scheduledTasksList_SelectionChanged"/>
        </GroupBox>

        <!-- Selected task details -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="selectedTaskStatus" Grid.Row="0" Margin="0,0,0,6"
                       AutomationProperties.AutomationId="selectedTaskStatus" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="toggleEnableButton" Content="Disable" MinWidth="80" Margin="0,0,6,0"
                        AutomationProperties.AutomationId="toggleEnableButton" Click="toggleEnableButton_Click"/>
                <Button x:Name="removeTaskButton" Content="Remove" MinWidth="80" Margin="0,0,6,0"
                        AutomationProperties.AutomationId="removeTaskButton" Click="removeTaskButton_Click"/>
                <Button x:Name="refreshButton" Content="Refresh" MinWidth="80"
                        AutomationProperties.AutomationId="refreshButton" Click="refreshButton_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Recent runs:" Margin="0,0,0,2"/>
            <ListBox x:Name="historyList" Grid.Row="3"
                     AutomationProperties.AutomationId="historyList"
                     HorizontalContentAlignment="Stretch"/>
        </Grid>

        <!-- Footer -->
        <Button x:Name="closeButton" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Close" MinWidth="90" Margin="0,8,0,0" HorizontalAlignment="Right"
                AutomationProperties.AutomationId="closeButton"
                Click="closeButton_Click"/>
    </Grid>
</Window>
