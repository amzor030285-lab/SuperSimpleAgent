<Application x:Class="SuperSimpleAgentGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <!-- ===================== -->
        <!-- SHARED DATA TEMPLATES -->
        <!-- ===================== -->

        <!-- Multi-select ListBox ItemTemplate with CheckBoxes -->
        <DataTemplate x:Key="MultiSelectListBoxItemTemplate">
            <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}">
                <TextBlock Text="{Binding}"/>
            </CheckBox>
        </DataTemplate>

        <!-- ===================== -->
        <!-- DYNAMIC COLOR BRUSHES -->
        <!-- ===================== -->

        <!-- Dynamic brush for button text color -->
        <SolidColorBrush x:Key="ButtonTextColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}"/>

        <!-- Dynamic brush for chat background color -->
        <SolidColorBrush x:Key="ChatBackgroundColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>

        <!-- Dynamic brush for label text color -->
        <SolidColorBrush x:Key="LabelTextColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}"/>

        <!-- Dynamic brush for chat text color -->
        <SolidColorBrush x:Key="ChatTextColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>

        <!-- Dynamic brush for code block background color -->
        <SolidColorBrush x:Key="CodeBlockBackgroundColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>

        <!-- Dynamic brush for window background color -->
        <SolidColorBrush x:Key="WindowBackgroundColorBrush"
                          Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>

        <!-- Dynamic brush for button background color -->
        <SolidColorBrush x:Key="ButtonBackgroundBrush"
                          Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>

        <!-- Dynamic brush for button border color -->
        <SolidColorBrush x:Key="ButtonBorderBrush"
                           Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}"/>

        <!-- Dynamic brush for the user message bubble background -->
        <SolidColorBrush x:Key="UserBubbleBackgroundBrush"
                           Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>

        <!-- Dynamic brush for code block header (language bar) background -->
        <SolidColorBrush x:Key="CodeBlockHeaderBrush"
                           Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>

        <!-- Dynamic brush for hyperlink text -->
        <SolidColorBrush x:Key="LinkBrush"
                           Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}"/>

        <!-- Dynamic brush for role labels and timestamps -->
        <SolidColorBrush x:Key="RoleLabelBrush"
                            Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}"/>

        <!-- Dynamic brush for markdown table grid lines -->
        <SolidColorBrush x:Key="TableBorderBrush"
                            Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}"/>

        <!-- Dynamic brush for markdown table header row background -->
        <SolidColorBrush x:Key="TableHeaderBackgroundBrush"
                            Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>

        <!-- ===================== -->
        <!-- FLAT BUTTON TEMPLATES -->
        <!-- ===================== -->

        <!-- Flat template for Buttons -->
        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Rectangle x:Name="Overlay"
                               Fill="{DynamicResource ButtonTextColorBrush}"
                               Opacity="0"
                               Visibility="Collapsed"/>
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Overlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Overlay" Property="Opacity" Value="0.08"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Overlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Overlay" Property="Opacity" Value="0.20"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Flat template for ToggleButtons (adds checked state) -->
        <ControlTemplate x:Key="FlatToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Rectangle x:Name="Overlay"
                               Fill="{DynamicResource ButtonTextColorBrush}"
                               Opacity="0"
                               Visibility="Collapsed"/>
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Overlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Overlay" Property="Opacity" Value="0.15"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Overlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Overlay" Property="Opacity" Value="0.08"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Overlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Overlay" Property="Opacity" Value="0.20"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ===================== -->
        <!-- GLOBAL CONTROL STYLES -->
        <!-- ===================== -->

        <!-- Themed ComboBox: the Aero template ignores Background/Foreground,
             so the chrome is replaced to follow the palette. -->
        <ControlTemplate x:Key="ThemedComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                              Focusable="False"
                              ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="4,0,2,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Path Grid.Column="1"
                                  Data="M 0 0 L 4 4 L 8 0"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </ToggleButton>
                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       IsOpen="{TemplateBinding IsDropDownOpen}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            MinWidth="{TemplateBinding ActualWidth}">
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ContentSite" Property="Opacity" Value="0.5"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2,6,2"/>
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
        </Style>

        <!-- ToggleButtons -->
        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template" Value="{StaticResource FlatToggleButtonTemplate}"/>
        </Style>

        <!-- RichTextBoxes -->
        <Style TargetType="RichTextBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ChatBackgroundColorBrush}"/>
        </Style>

        <!-- TextBoxes -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ChatBackgroundColorBrush}"/>
        </Style>

        <!-- PasswordBoxes -->
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ChatBackgroundColorBrush}"/>
        </Style>

        <!-- ListBoxes -->
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ChatBackgroundColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TableBorderBrush}"/>
        </Style>

        <!-- ComboBoxes -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template" Value="{StaticResource ThemedComboBoxTemplate}"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UserBubbleBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UserBubbleBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextColorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ToolTips -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- ScrollBars: the Aero bar draws its own chrome, so it is replaced by a
             thin palette-coloured thumb. Paging keys keep working. -->
        <Style x:Key="ScrollBarInvisibleRepeatButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ThemedScrollBarThumbTemplate" TargetType="{x:Type Thumb}">
            <Border Margin="4,2" CornerRadius="2" Background="{TemplateBinding Background}"/>
        </ControlTemplate>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollBarInvisibleRepeatButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource ButtonBorderBrush}"
                                           Template="{StaticResource ThemedScrollBarThumbTemplate}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollBarInvisibleRepeatButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBoxes -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource LabelTextColorBrush}"/>
        </Style>

        <!-- Labels -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource LabelTextColorBrush}"/>
        </Style>

    </Application.Resources>
</Application>
